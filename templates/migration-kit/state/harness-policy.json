{
  "schemaVersion": "standard-migration-policy/v2",
  "mode": "standard-full-project",
  "sourceProjectReadOnly": true,
  "productProjectReadOnly": true,
  "generatedWriteRoot": "migration",
  "pilotIsCalibrationOnly": true,
  "requireRealVerificationEvidence": true,
  "forbidSyntheticValidationEvidence": true,
  "maxRemediationCyclesPerInvocation": 5,
  "maxRepairPassesPerRun": 5,
  "maxChangesPerCycle": 1,
  "continueStartsFreshBudget": true,
  "continuousAutoAdvanceAfterProgress": true,
  "continuousRollsOverCycleBudget": true,
  "globalNoProgressStopEnabled": false,
  "candidateIdentity": "residual-id",
  "stopWhenResidualCandidatesExhausted": true,
  "regressionExhaustsCandidate": false,
  "verificationDimensionsIndependent": true,
  "maxAutonomousRemediationCyclesPerInvocation": 5,
  "oneWriteChangePerCycle": true,
  "requireFullRerunAfterEachCycle": true,
  "requireRemainingClusterClassificationBeforeManualHandoff": true,
  "cycleBudgetStopReason": "AUTONOMOUS_CYCLE_BUDGET_REACHED",
  "progressAuthority": "deterministic-core",
  "requireCoreRemediationEvaluation": true,
  "rejectAgentAuthoredProgressClassification": true,
  "requireRollbackOnRejectedCycle": true,
  "persistVisitedStateHashesAcrossInvocations": true,
  "cycleDetectedStopReason": "REMEDIATION_CYCLE_DETECTED",
  "residualExhaustionStopReason": "REMEDIATION_RESIDUAL_CANDIDATES_EXHAUSTED"
}
