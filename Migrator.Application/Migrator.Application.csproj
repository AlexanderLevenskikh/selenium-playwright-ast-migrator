<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>SeleniumPlaywrightMigrator.Application</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Description>Read-only application API for AST-based Selenium C# to Playwright .NET migration.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <ProjectReference Include="../Migrator.Core/Migrator.Core.csproj" />
    <ProjectReference Include="../Migrator.Roslyn/Migrator.Roslyn.csproj" />
    <ProjectReference Include="../Migrator.SeleniumCSharp/Migrator.SeleniumCSharp.csproj" />
    <ProjectReference Include="../Migrator.PlaywrightDotNet/Migrator.PlaywrightDotNet.csproj" />
  </ItemGroup>
</Project>
