{
  "name": "selenium-pw-migrator-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Desktop GUI for the Selenium -> Playwright migrator CLI.",
  "author": "Alexander Levenskikh",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 file:dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc -p tsconfig.electron.json && tsc -p tsconfig.app.json",
    "build": "npm run typecheck && vite build",
    "start": "electron .",
    "smoke": "npm run build && electron . --smoke",
    "smoke:with-data": "npm run build && electron . --smoke --smoke-out ../examples/simple-example-out",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wait-on": "^9.1.0"
  }
}
